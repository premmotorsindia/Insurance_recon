		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds the parameter record of the current company, creating it when missing.
    /// </summary>
    public static PMINSRECParameters find(boolean _forupdate = false)
    {
        PMINSRECParameters parameters;

        parameters.selectForUpdate(_forupdate);

        select firstonly parameters
            where parameters.Key == 0;

        if (!parameters && !parameters.isTmp())
        {
            Company::createParameter(parameters);
        }

        return parameters;
    }

]]></Source>
