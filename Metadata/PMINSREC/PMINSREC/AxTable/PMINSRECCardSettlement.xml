	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Reconciliation grid: one line per card bank and request ID (net of all card lines).
/// </summary>
public class PMINSRECCardSettlement extends common
{
}

]]></Declaration>
		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static PMINSRECCardSettlement find(
        PMINSRECCardBank  _cardBank,
        PMINSRECRequestId _requestId,
        boolean           _forupdate = false)
    {
        PMINSRECCardSettlement settlement;

        settlement.selectForUpdate(_forupdate);

        select firstonly settlement
            where settlement.CardBank  == _cardBank
               && settlement.RequestId == _requestId;

        return settlement;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findRecId</Name>
				<Source><![CDATA[
    public static PMINSRECCardSettlement findRecId(RecId _recId, boolean _forupdate = false)
    {
        PMINSRECCardSettlement settlement;

        settlement.selectForUpdate(_forupdate);

        select firstonly settlement
            where settlement.RecId == _recId;

        return settlement;
    }

]]></Source>
			</Method>
			<Method>
				<Name>isOpenForProcessing</Name>
				<Source><![CDATA[
    /// <summary>
    /// Lines that are skipped (net zero) or waiting for a user decision are not processed.
    /// </summary>
    public boolean isOpenForProcessing()
    {
        return this.Status != PMINSRECStatus::NetZeroSkipped
            && this.Status != PMINSRECStatus::Manual
            && this.Status != PMINSRECStatus::Completed;
    }

]]></Source>
			</Method>
		</Methods>
