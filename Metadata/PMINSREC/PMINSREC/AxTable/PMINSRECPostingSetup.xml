	<Name>PMINSRECPostingSetup</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Posting setup per card bank, insurance type (new car / renewal) and site.
/// </summary>
public class PMINSRECPostingSetup extends common
{
}

]]></Declaration>
		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static PMINSRECPostingSetup find(
        PMINSRECCardBank      _cardBank,
        PMINSRECInsuranceType _insuranceType,
        InventSiteId          _inventSiteId,
        boolean               _forupdate = false)
    {
        PMINSRECPostingSetup setup;

        setup.selectForUpdate(_forupdate);

        select firstonly setup
            where setup.CardBank      == _cardBank
               && setup.InsuranceType == _insuranceType
               && setup.InventSiteId  == _inventSiteId;

        return setup;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret = super();

        if (ret && this.InsuranceType == PMINSRECInsuranceType::None)
        {
            ret = checkFailed("Insurance type must be New car or Renewal.");
        }

        if (ret && this.InsuranceType == PMINSRECInsuranceType::Renewal && !this.FixedVendAccount)
        {
            ret = checkFailed("Fixed vendor is mandatory for renewal setup.");
        }

        if (ret && this.DiffAccountNum)
        {
            switch (this.DiffAccountType)
            {
                case LedgerJournalACType::Ledger:
                    if (!MainAccount::findByMainAccountId(this.DiffAccountNum))
                    {
                        ret = checkFailed(strFmt("Main account %1 does not exist.", this.DiffAccountNum));
                    }
                    break;

                case LedgerJournalACType::Cust:
                    if (!CustTable::exist(this.DiffAccountNum))
                    {
                        ret = checkFailed(strFmt("Customer %1 does not exist.", this.DiffAccountNum));
                    }
                    break;

                case LedgerJournalACType::Vend:
                    if (!VendTable::exist(this.DiffAccountNum))
                    {
                        ret = checkFailed(strFmt("Vendor %1 does not exist.", this.DiffAccountNum));
                    }
                    break;

                default:
                    ret = checkFailed("Difference account type must be Ledger, Customer or Vendor.");
            }
        }

        return ret;
    }

]]></Source>
			</Method>
		</Methods>
