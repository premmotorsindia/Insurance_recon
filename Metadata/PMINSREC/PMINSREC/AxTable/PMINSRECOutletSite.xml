	<Name>PMINSRECOutletSite</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Maps the outlet code of the insurance portal (2009, 2051, ...) to an inventory site.
/// </summary>
public class PMINSRECOutletSite extends common
{
}

]]></Declaration>
		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static PMINSRECOutletSite find(PMINSRECOutletCode _outletCode, boolean _forupdate = false)
    {
        PMINSRECOutletSite outletSite;

        if (_outletCode)
        {
            outletSite.selectForUpdate(_forupdate);

            select firstonly outletSite
                where outletSite.OutletCode == _outletCode;
        }

        return outletSite;
    }

]]></Source>
			</Method>
			<Method>
				<Name>siteId</Name>
				<Source><![CDATA[
    public static InventSiteId siteId(PMINSRECOutletCode _outletCode)
    {
        return PMINSRECOutletSite::find(_outletCode).InventSiteId;
    }

]]></Source>
			</Method>
		</Methods>
