		<Declaration><![CDATA[
/// <summary>
/// Excel column name per card bank and card file field (grid-to-Excel mapping).
/// </summary>
public class PMINSRECFileFormat extends common
{
}

]]></Declaration>
		<Methods>
			<Method>
				<Name>columnMap</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns a map PMINSRECCardField -> Excel column name for the given card bank.
    /// </summary>
    public static Map columnMap(PMINSRECCardBank _cardBank)
    {
        Map                columns = new Map(Types::Enum, Types::String);
        PMINSRECFileFormat format;

        while select format
            where format.CardBank == _cardBank
        {
            columns.insert(format.CardField, format.ColumnName);
        }

        return columns;
    }

]]></Source>
			</Method>
		</Methods>
