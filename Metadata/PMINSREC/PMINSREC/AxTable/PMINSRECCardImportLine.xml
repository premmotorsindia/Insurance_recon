/// </summary>
public class PMINSRECCardImportLine extends common
{
}

]]></Declaration>
		<Methods>
			<Method>
				<Name>isDuplicate</Name>
				<Source><![CDATA[
    /// <summary>
    /// Checks whether the same card line was already uploaded (same file uploaded twice).
    /// </summary>
    public boolean isDuplicate()
    {
        PMINSRECCardImportLine existing;

        if (this.TransactionId)
        {
            select firstonly RecId from existing
                where existing.CardBank      == this.CardBank
                   && existing.TransactionId == this.TransactionId
                   && existing.RequestId     == this.RequestId
                   && existing.DebitCredit   == this.DebitCredit;
        }
        else
        {
            select firstonly RecId from existing
                where existing.CardBank      == this.CardBank
                   && existing.RequestId     == this.RequestId
                   && existing.DebitCredit   == this.DebitCredit
                   && existing.Amount        == this.Amount
                   && existing.TransDate     == this.TransDate
                   && existing.TransTime     == this.TransTime;
        }

        return existing.RecId != 0;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
