	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Insurance portal individual report (new car / renewal). Supporting data for the card lines:
/// TC name (DLR_EXECUTIVE), IC name, registration number and chassis number.
/// </summary>
public class PMINSRECIndividualReport extends common
{
}

]]></Declaration>
		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static PMINSRECIndividualReport find(PMINSRECRequestId _proposalNo, boolean _forupdate = false)
    {
        PMINSRECIndividualReport report;

        if (_proposalNo)
        {
            report.selectForUpdate(_forupdate);

            select firstonly report
                where report.ProposalNo == _proposalNo;
        }

        return report;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
